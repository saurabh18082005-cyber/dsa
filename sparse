            }
        }
    for(i=0;i<rows;i++){
        for(j=0;j<columns;j++){
            printf("%d\t",matrix[i][j]);
        }
        printf("\n");
    }
    if (count<((rows*columns)/2))
    {
        printf("it is a sparse matrix\n");
         printf("in tuple form:rows,columns,value\n");
    for(i=0;i<count;i++){
        printf("%d,%d,%d\n",sparse[i].s_row,sparse[i].s_column,sparse[i].s_value);
    }
    }
