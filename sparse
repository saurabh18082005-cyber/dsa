    tuples sparse[MAX];
    printf("enter the no of rows between 1-5:");
    scanf("%d",&rows);
    printf("enter the no of columns between 1-5:");
    scanf("%d",&columns);
    for(i=0;i<rows;i++)
        for(j=0;j<columns;j++)
        {
            printf("enter the value for(%d,%d):",i,j);
            scanf("%d",&matrix[i][j]);
            if(matrix[i][j]!=0)
            {
                sparse[count].s_row=i;
                sparse[count].s_column=j;
