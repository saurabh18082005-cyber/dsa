#include<stdio.h>
#include<string.h>
#define MAX 100
int top=-1;
char stack[MAX];
void push(char c)
{
    if(top>=MAX-1)
    {
        printf("stack is full\n");
        return;
    }//end of if
    stack[++top]=c;
}//end of push
char pop()
{
    if(top==-1)
    {
        return '\0';
    }//end of if
    return stack[top--];
}//end of pop
int bracket_match(char open,char close)
{
    if(open=='('&&close==')')return 1;
    if(open=='['&&close==']')return 1;
    if(open=='{'&&close=='}')return 1;
    return 0;
}//end of bracket_match
int main()
{
    char exp[MAX];
    int is_valid=1;
    printf("Enter an expression:");
    scanf("%s",exp);
    for(int i=0;i<strlen(exp);i++)
    {
        if(exp[i]=='('||exp[i]=='['||exp[i]=='{')
        {
            push(exp[i]);
        }//end of if
        else if(exp[i]==')'||exp[i]==']'||exp[i]=='}')
        {
            if(top==-1)
            {
                is_valid=0;
                break;
            }//end of if
            char open_bracket=pop();
            int match=bracket_match(open_bracket,exp[i]);
            if(!match)
            {
                is_valid=0;
                break;
            }//end of if
        }//end of else if
    }//end of for
    if(is_valid&&top==-1)
    {
        printf("valid, brackets are properly balenced.\n");
    }//end of if
    else{
        printf("not valid, brackets are not properly balenced.\n");
    }//end of else
    return 0;
}//end of main
